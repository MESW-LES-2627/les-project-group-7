# Local PostgreSQL container (docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/les_db?schema=public"

# Staging / Production PostgreSQL (e.g. Neon, Supabase, Render)
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

PORT=3000

# Authentication (Better Auth, ADR-009). Use a different secret in every environment and never commit it.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Address of the site: http://localhost:3000 locally, the Vercel address of the site in dev and prod
BETTER_AUTH_URL=http://localhost:3000
