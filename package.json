{
  "name": "les-project-group-7",
  "version": "0.1.0",
  "private": true,
  "description": "Place reviews and day-by-day trip planning platform - MESW LES Group 7",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "import:osm": "tsx scripts/import-osm.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "lint:docs": "tsx scripts/validate-docs.ts",
    "format:docs": "prettier --write \"docs/**/*.md\"",
    "knip": "knip",
    "analyze": "ANALYZE=true next build",
    "ui:detect": "impeccable detect src/"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "impeccable": "^4.7.0",
    "jsdom": "^31.0.1",
    "knip": "^6.42.1",
    "postcss": "^8.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.4.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
