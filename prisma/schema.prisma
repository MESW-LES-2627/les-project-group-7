// Prisma schema for Place Reviews & Trip Planning
// Database configuration: PostgreSQL (local via Docker or hosted via Neon/Supabase)

generator client {
  provider      = "prisma-client-js"
  // "native" = the machine that runs `prisma generate` (laptop, CI runner).
  // "rhel-openssl-3.0.x" = the Amazon Linux runtime of Vercel Functions, which differs from the CI runner.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PlaceCategory {
  RESTAURANT
  MUSEUM
  MONUMENT
  PARK
  CAFE
  BAR
  OTHER
}

enum SavedPlaceType {
  WISHLIST
  BOOKMARK
}

enum ItineraryMode {
  MANUAL
  GENERATED
}

// -------------------------------------------------------------
// 1. Identity & Users
// -------------------------------------------------------------
model User {
  id           String       @id @default(uuid())
  username     String       @unique   // stored in lower case; displayUsername keeps what the person typed
  email        String       @unique   // stored in lower case
  // Legacy: the password hash now lives in Account.password, kept by the authentication library
  // (ADR-009). Optional until the seed and the reviews endpoint stop writing it; dropped later.
  passwordHash String?
  role         Role         @default(USER)
  registeredAt DateTime     @default(now())

  // Columns required by the authentication library (Better Auth, ADR-009)
  name            String                 // set to the username
  emailVerified   Boolean   @default(false)
  image           String?
  updatedAt       DateTime  @updatedAt
  displayUsername String?
  sessions        Session[]
  accounts        Account[]

  reviews      Review[]
  visits       Visit[]
  savedPlaces  SavedPlace[]
  savedLists   SavedList[]
  trips        Trip[]
}

// -------------------------------------------------------------
// 2. Catalog: City & Place
// -------------------------------------------------------------
model City {
  id        String   @id @default(uuid())
  name      String
  country   String
  latitude  Float
  longitude Float

  places    Place[]
  trips     Trip[]
}

model Place {
  id            String        @id @default(uuid())
  osmId         String?       @unique
  name          String
  description   String?
  category      PlaceCategory
  address       String
  latitude      Float
  longitude     Float
  openingHours  String?       // OSM opening_hours string or "unknown"
  priceLevel    String?       // "FREE" | "€" | "€€" | "€€€" (FREE if OSM fee=no, else the mode of the reviews)
  averageRating Float?        // 1.0 .. 5.0
  reviewCount   Int           @default(0)
  source        String        @default("IMPORTED") // "IMPORTED" | "SUGGESTED" | "LAZY_OSM"

  cityId        String
  city          City          @relation(fields: [cityId], references: [id])

  reviews       Review[]
  visits        Visit[]
  savedPlaces   SavedPlace[]
  listEntries   ListEntry[]
  itineraryStops ItineraryStop[]
}

// -------------------------------------------------------------
// 3. Reviews & Visits
// -------------------------------------------------------------
model Review {
  id         String   @id @default(uuid())
  rating     Int      // 1 .. 5
  priceLevel String?  // "€" | "€€" | "€€€"
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeId    String
  place      Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model Visit {
  userId    String
  placeId   String
  visitedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
}

// -------------------------------------------------------------
// 4. Saved Places & Custom Lists
// -------------------------------------------------------------
model SavedPlace {
  id      String         @id @default(uuid())
  type    SavedPlaceType // WISHLIST | BOOKMARK
  savedAt DateTime       @default(now())

  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeId String
  place   Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId, type])
}

model SavedList {
  id        String      @id @default(uuid())
  name      String
  createdAt DateTime    @default(now())

  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries   ListEntry[]
}

model ListEntry {
  id        String    @id @default(uuid())
  addedAt   DateTime  @default(now())

  listId    String
  list      SavedList @relation(fields: [listId], references: [id], onDelete: Cascade)

  placeId   String
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([listId, placeId])
}

// -------------------------------------------------------------
// 5. Trips & Itineraries
// -------------------------------------------------------------
model Trip {
  id                String    @id @default(uuid())
  name              String
  startDate         DateTime
  endDate           DateTime
  budgetLevel       String    // "€" | "€€" | "€€€"
  dayStart          String    @default("09:00") // "HH:mm", the day starts at 08:00 or later
  dayEnd            String    @default("20:00") // "HH:mm", the day ends at 23:00 or earlier
  allowedCategories String    // Stored as JSON or comma-separated PlaceCategories
  createdAt         DateTime  @default(now())

  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  cityId            String
  city              City      @relation(fields: [cityId], references: [id])

  days              Day[]
  itinerary         Itinerary?
}

model Day {
  id        String   @id @default(uuid())
  dayNumber Int      // 1, 2, ...
  date      DateTime

  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  stops     ItineraryStop[]
}

model Itinerary {
  id        String        @id @default(uuid())
  mode      ItineraryMode @default(MANUAL)
  createdAt DateTime      @default(now())

  tripId    String        @unique
  trip      Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)

  stops     ItineraryStop[]
}

model ItineraryStop {
  id           String    @id @default(uuid())
  visitTime    String?   // "HH:mm"
  position     Int       // 1, 2, 3 within the Day
  reminderSent Boolean   @default(false)

  itineraryId  String
  itinerary    Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  dayId        String
  day          Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)

  placeId      String
  place        Place     @relation(fields: [placeId], references: [id])
}

// -------------------------------------------------------------
// 6. Authentication (Better Auth, ADR-009). Created and read by the library.
// -------------------------------------------------------------
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// The password of a user is here (providerId "credential"), as a salted scrypt hash.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Counters of the login rate limit, stored in the database because memory does not suit serverless.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}
