@startuml change-scenario-before
title Change scenario "edit and delete a review" - before the decision (copy the steps)
skinparam shadowing false
skinparam componentStyle uml2
skinparam ArrowColor #555555
skinparam component {
  BackgroundColor #FFF8E1
  BorderColor #666666
  BackgroundColor<<planned>> #EEEEEE
}

legend right
  |<#FFF8E1> Exists today |
  |<#EEEEEE> Planned (US-C2-01, Iteration 2) |
  Each caller loads the reviews, applies the rules of
  src/domain/reviews/rating.ts and writes the three stored
  values of the place. That sequence is written once per caller.
endlegend

component "POST /api/reviews\n(post a review)" as post
component "PATCH /api/reviews/[id]\n(edit a review)" as patch <<planned>>
component "DELETE /api/reviews/[id]\n(delete a review)" as del <<planned>>
component "prisma/seed.ts\n(demo data)" as seed
component "src/domain/reviews/rating.ts\n(average, price level rules)" as rating
database "Place\naverageRating, reviewCount,\npriceLevel" as place #E8E8E8

post ..> rating
patch ..> rating
del ..> rating
seed ..> rating
post --> place : writes the 3 values
patch --> place : writes the 3 values
del --> place : writes the 3 values
seed --> place : writes the 3 values
@enduml
